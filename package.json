{
  "name": "@weiguangchao/susan",
  "version": "0.0.1",
  "description": "Minimal personal TUI harness agent",
  "type": "module",
  "bin": {
    "susan": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/cli.ts --config config.dev.json",
    "prototype": "tsx prototype/tui-prototype.tsx",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsdown",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "ink": "^7.1.1",
    "openai": "^7.9.0",
    "react": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
