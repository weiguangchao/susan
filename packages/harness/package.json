{
  "name": "@weiguangchao/susan-harness",
  "version": "0.0.1",
  "type": "module",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22 <26"
  },
  "scripts": {
    "build:core": "pnpm --filter @weiguangchao/susan-core build",
