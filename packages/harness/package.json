    "package:smoke": "pnpm run build && node scripts/package-smoke.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "dependencies": {
    "@weiguangchao/susan-core": "workspace:~",
