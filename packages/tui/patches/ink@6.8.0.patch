index 0000000000000000000000000000000000000000..61ec120a65bccb2a8755de3c333b2177a21f2542
--- /dev/null
+++ b/build/scrollback-renderer.js
@@ -0,0 +1,65 @@
+// Repaint only the terminal viewport. Old transcript rows in native scrollback
+// must never be cleared or replayed during streaming updates.
+export function renderViewport(staticOutput, output, rows, previous, cursorPosition, staticHeight, previousStart) {
+    const dynamicLines = output.split('\n');
+    const totalLines = staticHeight + dynamicLines.length;
+    const start = Math.max(0, totalLines - rows);
+    const scrollRows = Math.max(0, start - previousStart);
+    let staticTail = '';
+    const neededStaticRows = Math.max(0, rows + scrollRows - dynamicLines.length);
+    if (neededStaticRows > 0) {
+        let cut = staticOutput.length;
+        for (let count = 0; count <= neededStaticRows; count++) {
+            cut = staticOutput.lastIndexOf('\n', cut - 1);
+            if (cut < 0) break;
+        }
+        staticTail = staticOutput.slice(cut + 1);
+    }
+    const all = (staticTail + output).split('\n');
+    const base = totalLines - all.length;
+    const lines = all.slice(-rows);
+    while (lines.length < rows) lines.unshift('');
+    const writes = [];
+    let painted = previous;
+    const paint = (next) => {
+        for (let row = 0; row < rows; row++) {
+            if (next[row] !== painted?.[row]) {
+                writes.push(`\x1b[${row + 1};1H\x1b[2K${next[row] ?? ''}`);
+            }
+        }
+        painted = next;
+    };
+    for (let step = 1; step <= scrollRows; step++) {
+        writes.push(`\x1b[${rows};1H\n`);
+        painted = painted ? [...painted.slice(1), ''] : undefined;
+        const intermediateStart = previousStart + step - base;
+        const intermediate = all.slice(intermediateStart, intermediateStart + rows);
+        while (intermediate.length < rows) intermediate.push('');
+        paint(intermediate);
+    }
+    paint(lines);
+    // log-update's cursor suffix expects the physical cursor on the last row.
+    writes.push(`\x1b[${rows};1H`);
+    const absoluteY = staticHeight + (cursorPosition?.y ?? 0);
+    const localY = absoluteY - start + Math.max(0, rows - totalLines);
+    return {
+        lines,
+        start,
+        evictedLiveRows: Math.max(0, start - Math.max(previousStart, staticHeight)),
+        sequence: writes.join(''),
+        visibleOutput: lines.join('\n'),
+        cursorPosition: cursorPosition && localY >= 0 && localY < rows
+            ? { x: cursorPosition.x, y: localY }
+            : undefined,
+    };
+}
+
+// Replace the old live area with its final Static text. Completed text is
+// appended once, while earlier static rows remain in the native scrollback.
+export function commitViewport(staticOutput, output, rows, staticHeight, liveHeight, frozenLiveRows) {
+    const offset = Math.max(0, staticHeight + liveHeight - rows);
+    const firstLiveRow = Math.max(0, staticHeight - offset);
+    const lines = staticOutput.split('\n');
+    const remaining = lines.slice(Math.min(frozenLiveRows, lines.length - 1)).join('\n');
+    return `\x1b[${firstLiveRow + 1};1H\x1b[0J${remaining}${output}`;
+}
